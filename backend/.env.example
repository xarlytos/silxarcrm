# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/crm_maestro?schema=public

# Redis
REDIS_URL=redis://localhost:6379
# Or Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# OpenAI (o proveedor compatible: MiniMax, CometAPI, OpenRouter, Groq, etc.)
# Deja OPENAI_BASE_URL vacío para usar la API oficial de OpenAI.
# Ejemplos:
#   MiniMax oficial:  https://api.minimaxi.chat/v1
#   CometAPI:         https://api.cometapi.com/v1
#   OpenRouter:       https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-1106-preview
OPENAI_BASE_URL=

# Zadarma (Centro de Llamadas)
ZADARMA_USER_KEY=
ZADARMA_SECRET_KEY=
ZADARMA_NUMBER_DID=
ZADARMA_DEFAULT_AGENT_PHONE=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# Or full JSON
FIREBASE_SERVICE_ACCOUNT=

# Google Places API (New) — import de leads desde Google Maps
GOOGLE_PLACES_API_KEY=

# Resend (Email outreach)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
EMAIL_UNSUBSCRIBE_SECRET=cambia-este-secret-min-32-chars

# Frontend
FRONTEND_URL=http://localhost:3000
MOBILE_APP_SCHEME=crm-maestro

# Features
FCM_ENABLED=true
LOG_LEVEL=info
