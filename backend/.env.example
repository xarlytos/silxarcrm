# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/crm_maestro?schema=public

# Redis
REDIS_URL=redis://localhost:6379
# Or Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-1106-preview

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# Or full JSON
FIREBASE_SERVICE_ACCOUNT=

# Webhook Secrets
WEBHOOK_SECRET_ENTRENADORES=whsec_...
WEBHOOK_SECRET_NUTRICION=whsec_...

# Frontend
FRONTEND_URL=http://localhost:3000
MOBILE_APP_SCHEME=crm-maestro

# Features
FCM_ENABLED=true
LOG_LEVEL=info
