generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ClienteGlobal {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  nombre              String
  telefono            String?
  pais                String?
  empresa             String?
  origenSaas          String    @map("origen_saas")
  clienteSaasId       String?   @map("cliente_saas_id")
  estado              String    @default("activo")
  fechaRegistro       DateTime  @default(now()) @map("fecha_registro")
  ultimaActualizacion DateTime  @updatedAt @map("ultima_actualizacion")
  fechaUltimoLogin    DateTime? @map("fecha_ultimo_login")
  metadata            Json?
  notasInternas       String?   @map("notas_internas")

  // Encrypted PII fields (AES-256-GCM)
  encrypted_nombre    String?   @map("encrypted_nombre")
  encrypted_email     String?   @map("encrypted_email")
  encrypted_telefono  String?   @map("encrypted_telefono")
  encryption_key_id   String?   @map("encryption_key_id") // versioning support for key rotation
  encrypted_at        DateTime? @map("encrypted_at")

  suscripciones Suscripcion[]
  pagos         Pago[]
  eventos       Evento[]

  // Growth Engine
  referralPrograms ReferralProgram[]

  @@index([origenSaas])
  @@index([estado])
  @@index([fechaRegistro])
  @@map("clientes_global")
}

model Suscripcion {
  id                  Int       @id @default(autoincrement())
  clienteId           Int       @map("cliente_id")
  saas                String
  planTipo            String    @map("plan_tipo")
  estado              String
  monto               Decimal   @db.Decimal(10, 2)
  moneda              String    @default("EUR")
  montoProporcional   Decimal?  @map("monto_proporcional") @db.Decimal(10, 2)
  fechaInicio         DateTime  @map("fecha_inicio")
  fechaFin            DateTime? @map("fecha_fin")
  fechaProximoPago    DateTime? @map("fecha_proximo_pago")
  fechaUltimoPago     DateTime? @map("fecha_ultimo_pago")
  fechaCancelacion    DateTime? @map("fecha_cancelacion")
  diasTrialTotal      Int?      @map("dias_trial_total")
  diasTrialRestantes  Int?      @map("dias_trial_restantes")
  metodoPago          String?   @map("metodo_pago")
  paymentProviderId   String?   @map("payment_provider_id")
  facturaUrl          String?   @map("factura_url")
  motivoCancelacion   String?   @map("motivo_cancelacion")
  cancelacionInitBy   String?   @map("cancelacion_initiated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  cliente ClienteGlobal @relation(fields: [clienteId], references: [id])
  pagos   Pago[]
  eventos Evento[]

  @@index([clienteId])
  @@index([saas])
  @@index([estado])
  @@index([fechaProximoPago])
  @@index([planTipo, estado])
  @@map("suscripciones")
}

model Pago {
  id                Int       @id @default(autoincrement())
  suscripcionId     Int       @map("suscripcion_id")
  clienteId         Int       @map("cliente_id")
  monto             Decimal   @db.Decimal(10, 2)
  moneda            String    @default("EUR")
  estado            String
  metodoPago        String?   @map("metodo_pago")
  paymentProviderId String?   @map("payment_provider_id")
  descripcion       String?
  fechaPago         DateTime  @map("fecha_pago")
  fechaReembolso    DateTime? @map("fecha_reembolso")
  numeroFactura     String?   @map("numero_factura")
  facturaUrl        String?   @map("factura_url")
  rawResponse       Json?     @map("raw_response")
  createdAt         DateTime  @default(now()) @map("created_at")

  suscripcion Suscripcion   @relation(fields: [suscripcionId], references: [id])
  cliente     ClienteGlobal @relation(fields: [clienteId], references: [id])

  @@index([suscripcionId])
  @@index([fechaPago])
  @@index([estado])
  @@map("pagos")
}

model Evento {
  id                  Int       @id @default(autoincrement())
  tipo                String
  severidad           String    @default("info")
  clienteId           Int?      @map("cliente_id")
  suscripcionId       Int?      @map("suscripcion_id")
  saas                String?
  datos               Json?
  procesado           Boolean   @default(false)
  notificadoPush      Boolean   @default(false) @map("notificado_push")
  notificadoDashboard Boolean   @default(false) @map("notificado_dashboard")
  ipOrigen            String?   @map("ip_origen")
  userAgent           String?   @map("user_agent")
  fecha               DateTime  @default(now())

  cliente     ClienteGlobal? @relation(fields: [clienteId], references: [id])
  suscripcion Suscripcion?   @relation(fields: [suscripcionId], references: [id])

  @@index([tipo])
  @@index([saas])
  @@index([fecha])
  @@index([procesado])
  @@index([notificadoPush])
  @@index([clienteId, fecha])
  @@map("eventos")
}

model MetricaDiaria {
  id                Int      @id @default(autoincrement())
  fecha             DateTime @db.Date
  saas              String
  nuevosRegistros   Int      @default(0) @map("nuevos_registros")
  nuevosPagos       Int      @default(0) @map("nuevos_pagos")
  cancelaciones     Int      @default(0)
  upgrades          Int      @default(0)
  downgrades        Int      @default(0)
  clientesActivos   Int      @default(0) @map("clientes_activos")
  trialsActivos     Int      @default(0) @map("trials_activos")
  trialsConvertidos Int      @default(0) @map("trials_convertidos")
  trialsExpirados   Int      @default(0) @map("trials_expirados")
  mrr               Decimal  @default(0) @db.Decimal(12, 2)
  arr               Decimal  @default(0) @db.Decimal(12, 2)
  ingresosNuevos    Decimal  @default(0) @map("ingresos_nuevos") @db.Decimal(12, 2)
  ingresosPerdidos  Decimal  @default(0) @map("ingresos_perdidos") @db.Decimal(12, 2)
  loginsTotales     Int      @default(0) @map("logins_totales")
  featureMasUsada   String?  @map("feature_mas_usada")
  churnRate         Decimal? @map("churn_rate") @db.Decimal(5, 2)
  conversionRate    Decimal? @map("conversion_rate") @db.Decimal(5, 2)
  trialToPaidRate   Decimal? @map("trial_to_paid_rate") @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([fecha, saas])
  @@index([fecha])
  @@index([saas])
  @@map("metricas_diarias")
}

model WebhookConfig {
  id               Int       @id @default(autoincrement())
  saas             String    @unique
  webhookSecret    String    @map("webhook_secret")
  endpointUrl      String    @map("endpoint_url")
  activo           Boolean   @default(true)
  reintentosMax    Int       @default(3) @map("reintentos_maximos")
  timeoutMs        Int       @default(5000) @map("timeout_ms")
  ultimoError      String?   @map("ultimo_error")
  ultimoErrorAt    DateTime? @map("ultimo_error_at")
  descripcion      String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("webhooks_config")
}

// --- Perfil de Software/SaaS (configuracion y marketing) ---
model Software {
  id                String   @id @default(cuid())
  slug              String   @unique // ej: "groomly", "silxar" — coincide con saas/softwareId
  nombre            String   // ej: "Groomly Pro"
  tagline           String?  // One-liner para headers, ads, meta description
  descripcion       String?  @db.Text // Pitch largo para landing pages
  urlWebsite        String?  @map("url_website")
  logoUrl           String?  @map("logo_url")
  faviconUrl        String?  @map("favicon_url")
  colorPrimario     String   @default("#6366F1") @map("color_primario")
  colorSecundario   String?  @map("color_secundario")
  dominioLanding    String?  @map("dominio_landing")

  // Posicionamiento
  categoria         String?  // ej: "SaaS", "Agencia", "Consultoria"
  nicho             String?  // ej: "peluquerias caninas"
  problemaPrincipal String?  @map("problema_principal") @db.Text
  promesaValor      String?  @map("promesa_valor") @db.Text
  diferenciador     String?  @db.Text

  // Audiencia objetivo (ICP)
  icpTitulo         String?  @map("icp_titulo")
  icpDescripcion    String?  @map("icp_descripcion") @db.Text
  icpIngresosAnuales String? @map("icp_ingresos_anuales")
  icpTamanoEquipo   String?  @map("icp_tamano_equipo")
  icpUbicacion      String?  @map("icp_ubicacion")
  icpDolorTop1      String?  @map("icp_dolor_top1")
  icpDolorTop2      String?  @map("icp_dolor_top2")
  icpDolorTop3      String?  @map("icp_dolor_top3")

  // Estado
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relaciones Growth Engine
  growthConfig           GrowthConfig?
  contentPieces          ContentPiece[]
  referralPrograms       ReferralProgram[]
  marketplaceOpportunities MarketplaceOpportunity[]
  growthMetrics          GrowthMetric[]
  socialAccounts         SocialAccount[]
  voiceAgentConfig       VoiceAgentConfig?
  brands                 Brand[]
  campaigns              SocialCampaign[]
  radarConfig            RadarConfig?
  radarRuns              RadarRun[]
  auditorias             Auditoria[]

  @@index([slug])
  @@index([activo])
  @@map("softwares")
}

// --- Sales Playbook: estrategia comercial independiente del software ---
model SalesPlaybook {
  id            String   @id @default(cuid())
  playbookId    String   @unique @map("playbook_id")  // ej: "free_value_v1"
  name          String
  description   String?  @db.Text
  version       String   @default("v1")

  // Funnel de ventas: etapas ordenadas
  stages        Json     // [{id, name, objective, duration_hint, key_points[], prohibitions[], transitions{}}]

  // Scripts por etapa (anti-monotonia)
  scripts       Json     // {pattern_interrupt: ["a", "b"], discovery: [...], ...}

  // Manejadores de objeciones
  objectionHandlers Json @map("objection_handlers")  // {precio: {framework, script}, ...}

  // Gatekeeper
  gatekeeper    Json     // {max_turns, script, fallback}

  // Configuracion de quantificacion
  quantification Json    // {enabled, ask_for_numbers, currency_in_message, focus_on_roi}

  // Config de value offer
  valueOffer    Json     @map("value_offer")  // {enabled, type, delivery}

  // A/B test metadata
  abTest        Json?    @map("ab_test")  // {experiment_id, variant, parent_playbook_id}

  // Relaciones
  voiceAgentConfigs VoiceAgentConfig[]

  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([playbookId])
  @@index([activo])
  @@map("sales_playbooks")
}

// --- Case Studies: casos de exito por vertical/pais ---
model CaseStudy {
  id                 String   @id @default(cuid())

  tipoNegocio        String   @map("tipo_negocio")  // "dentista", "peluqueria_canina"...
  empresa            String
  ciudad             String
  pais               String   // "es", "mx"...
  resultado          String   @db.Text
  metricaDestacada   String?  @map("metrica_destacada")
  testimonial        String?  @db.Text
  tiempoAResultado   String?  @map("tiempo_a_resultado")
  tags               String[] // ["no-shows", "whatsapp", "automatizacion"]

  // Para filtrado por software
  softwareId         String?  @map("software_id")

  activo             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([tipoNegocio])
  @@index([pais])
  @@index([ciudad])
  @@index([softwareId])
  @@index([activo])
  @@map("case_studies")
}

// --- Configuracion del Agente de Voz AI por Software (modular LEGO v2) ---
// Ya NO es un God Object. Delega en SalesPlaybook, CaseStudy, y sub-configs.
model VoiceAgentConfig {
  id                     String   @id @default(cuid())
  softwareId             String   @unique @map("software_id")
  software               Software @relation(fields: [softwareId], references: [id], onDelete: Cascade)

  // -- Referencia al Playbook (separado de la config) --
  playbookId             String   @map("playbook_id")
  playbook               SalesPlaybook @relation(fields: [playbookId], references: [playbookId])

  // -- Identity (quien es el agente) --
  agentName              String   @map("agent_name")
  agentGender            String   @default("masculino") @map("agent_gender")
  agentAccent            String   @default("es-ES") @map("agent_accent")
  agentTone              String   @default("profesional_cercano") @map("agent_tone")
  agentExperienceYears   Int      @default(4) @map("agent_experience_years")
  elevenlabsVoiceId      String?  @map("elevenlabs_voice_id")

  // -- Product (que se vende) --
  companyName            String   @map("company_name")
  productName            String   @map("product_name")
  productDescription     String   @db.Text @map("product_description")
  targetVertical         String   @map("target_vertical")
  targetAudience         String?  @map("target_audience")
  currency               String   @default("EUR") @map("currency")
  currencySymbol         String   @default("EUR") @map("currency_symbol")
  marketCountry          String   @default("es") @map("market_country")
  marketCityExamples     String?  @map("market_city_examples")
  priceMonthly           Int      @map("price_monthly")

  // -- Pain Points (JSON, ligero) --
  painPoints             Json     @map("pain_points")  // {dolor_principal, ejemplos[], keywords[]}

  // -- Competitors (JSON, ligero) --
  competitorComparisons  Json     @map("competitor_comparisons")  // {calendly: {...}, excel: {...}}

  // -- Free Value / Auditoria --
  freeValueOffer         String   @db.Text @map("free_value_offer")
  auditoriaBaseUrl       String?  @map("auditoria_base_url")
  auditoriaEnabled       Boolean  @default(true) @map("auditoria_enabled")

  // -- WhatsApp / Follow-up --
  whatsappSenderName     String   @default("Mariana") @map("whatsapp_sender_name")
  whatsappTemplates      Json     @map("whatsapp_templates")
  followUpEmailSender    String?  @map("follow_up_email_sender")
  followUpEmailSubject   String?  @map("follow_up_email_subject")

  // -- Compliance --
  disclosureText         String   @default("Soy un asistente virtual de {companyName}") @map("disclosure_text")
  callHourStart          Int      @default(9) @map("call_hour_start")
  callHourEnd            Int      @default(20) @map("call_hour_end")
  callDaysAllowed        String   @default("1,2,3,4,5,6") @map("call_days_allowed")
  timezone               String   @default("Europe/Madrid")
  optoutEnabled          Boolean  @default(true) @map("optout_enabled")

  // -- Voice / Telephony --
  twilioCnamName         String?  @map("twilio_cnam_name")
  twilioFromNumber       String?  @map("twilio_from_number")
  callerIdStrategy       String   @default("static") @map("caller_id_strategy")

  // -- A/B Test --
  abTestVariant          String?  @map("ab_test_variant")  // "A" | "B" | null
  abTestPlaybookId       String?  @map("ab_test_playbook_id")  // playbook alternativo

  // -- Estado --
  activo                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([softwareId])
  @@index([playbookId])
  @@index([activo])
  @@map("voice_agent_configs")
}

// Sistema de Tracking de Eventos (tipo Segment/Mixpanel)
model CrmClient {
  id          String   @id @default(cuid())
  name        String
  saas        String   // Identificador del SaaS
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  apiKeys ApiKey[]
  trackedEvents TrackedEvent[]

  @@index([saas])
  @@index([activo])
  @@map("crm_clients")
}

model ApiKey {
  id          String    @id @default(cuid())
  crmId       String    @map("crm_id")
  keyHash     String    @map("key_hash") // Hash de la key, nunca guardamos la key en plain text
  keyPrefix   String    @map("key_prefix") // Primeros 8 caracteres para identificación
  nombre      String?   // Ej: "Producción", "Desarrollo"
  activo      Boolean   @default(true)
  ultimoUso   DateTime? @map("ultimo_uso")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  crmClient CrmClient @relation(fields: [crmId], references: [id], onDelete: Cascade)

  @@index([crmId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model TrackedEvent {
  id          String   @id @default(cuid())
  crmId       String   @map("crm_id")
  eventName   String   @map("event_name")
  eventId     String?  @map("event_id") // ID único para deduplicación
  userId      String?  @map("user_id")
  email       String?
  sessionId   String?  @map("session_id")
  datos       Json     // Payload completo del evento
  timestamp   DateTime
  recibidoAt  DateTime @default(now()) @map("recibido_at")
  ipOrigen    String?  @map("ip_origen")
  userAgent   String?  @map("user_agent")
  procesado   Boolean  @default(false)

  crmClient CrmClient @relation(fields: [crmId], references: [id], onDelete: Cascade)

  @@index([crmId])
  @@index([eventName])
  @@index([timestamp])
  @@index([eventId])
  @@index([userId])
  @@index([procesado])
  @@map("tracked_events")
}

enum LeadEstado {
  NUEVO
  CONTACTADO
  INTERESADO
  EN_SEGUIMIENTO
  CALIFICADO
  RECHAZADO
  NO_RESPONDE
  CONVERTIDO
}

enum PrioridadLead {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

model Lead {
  id             String      @id @default(cuid())
  nombre         String
  email          String?
  telefono       String?
  empresa        String?
  cargo          String?
  pais           String?
  origen         String      @default("manual")
  softwareId     String      @map("software_id")
  estado         LeadEstado  @default(NUEVO)
  prioridad      PrioridadLead @default(MEDIA)
  notas          String?
  ultimoContacto DateTime?   @map("ultimo_contacto")
  asignadoA      Int?        @map("asignado_a")
  convertidoA    Int?        @map("convertido_a")
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Encrypted PII fields (AES-256-GCM)
  encrypted_nombre    String?   @map("encrypted_nombre")
  encrypted_email     String?   @map("encrypted_email")
  encrypted_telefono  String?   @map("encrypted_telefono")
  encryption_key_id   String?   @map("encryption_key_id") // versioning support for key rotation
  encrypted_at        DateTime? @map("encrypted_at")

  historial      LeadHistorial[]
  etiquetas      LeadEtiqueta[]
  gestor         UsuarioCrm?     @relation(fields: [asignadoA], references: [id])
  llamadas       LlamadaReal[]
  whatsappEnvios WhatsappEnvio[]
  whatsappConversacion WhatsappConversacion?

  // Growth Engine
  contentPieces  ContentPiece[]
  marketplaceOpportunities MarketplaceOpportunity[]
  activationLogs ActivationLog[]

  @@unique([email, softwareId])
  @@index([estado])
  @@index([prioridad])
  @@index([softwareId])
  @@index([asignadoA])
  @@index([createdAt])
  @@map("leads")
}

model ContactoProspecto {
  id              String      @id @default(cuid())
  nombre          String
  email           String?
  telefono        String?
  empresa         String?
  cargo           String?
  ciudad          String?
  pais            String?
  softwareId      String      @map("software_id")
  fuente          String      @default("radar")         // radar | manual | importacion
  estado          String      @default("nuevo")          // nuevo | contactado | interesado | descartado
  leadId          String?     @map("lead_id")            // vincular a Lead cuando se convierte
  notas           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Encrypted PII fields (AES-256-GCM)
  encrypted_nombre    String?   @map("encrypted_nombre")
  encrypted_email     String?   @map("encrypted_email")
  encrypted_telefono  String?   @map("encrypted_telefono")
  encryption_key_id   String?   @map("encryption_key_id") // versioning support for key rotation
  encrypted_at        DateTime? @map("encrypted_at")

  @@unique([email, softwareId])
  @@index([estado])
  @@index([softwareId])
  @@index([fuente])
  @@index([createdAt])
  @@map("contactos_prospecto")
}

model LeadHistorial {
  id          String   @id @default(cuid())
  leadId      String   @map("lead_id")
  tipo        String
  descripcion String
  usuarioId   Int?     @map("usuario_id")
  createdAt   DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_historial")
}

model LeadEtiqueta {
  id     String @id @default(cuid())
  nombre String @unique
  color  String @default("#6B7280")
  leads  Lead[]

  @@map("lead_etiquetas")
}

model WhatsappPlantilla {
  id         String   @id @default(cuid())
  softwareId String   @map("software_id")
  nombre     String
  contenido  String
  categoria  String   @default("general")
  variables  String[] @default([])
  activa     Boolean  @default(true)
  orden      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  envios     WhatsappEnvio[]
  variantes  WhatsappABTestVariante[]
  battlesAsA WhatsappArenaBattle[] @relation("BattlesAsA")
  battlesAsB WhatsappArenaBattle[] @relation("BattlesAsB")

  @@index([softwareId])
  @@index([categoria])
  @@index([activa])
  @@map("whatsapp_plantillas")
}

model WhatsappEnvio {
  id             String    @id @default(cuid())
  leadId         String    @map("lead_id")
  plantillaId    String?   @map("plantilla_id")
  varianteId     String?   @map("variante_id")
  telefono       String
  mensaje        String
  usuarioId      Int?      @map("usuario_id")
  enviadoAt      DateTime  @default(now()) @map("enviado_at")
  programadoPara DateTime? @map("programado_para")
  estado         String    @default("enviado") @map("estado") // 'enviado' | 'programado' | 'fallido'

  lead      Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  plantilla WhatsappPlantilla? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  variante  WhatsappABTestVariante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([plantillaId])
  @@index([varianteId])
  @@index([enviadoAt])
  @@map("whatsapp_envios")
}

model WhatsappChatbotRegla {
  id           String   @id @default(cuid())
  softwareId   String   @map("software_id")
  nombre       String
  palabrasClave String[] @map("palabras_clave")
  respuesta    String
  tipo         String   @default("keyword") // 'keyword' | 'ia'
  activa       Boolean  @default(true)
  orden        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([softwareId])
  @@index([activa])
  @@map("whatsapp_chatbot_reglas")
}

model WhatsappABTest {
