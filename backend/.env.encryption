# Field-level Encryption Configuration
# Add these to your .env file (keep secure, never commit to git)

# Master encryption key (32-byte hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be kept secret and backed up securely
ENCRYPTION_MASTER_KEY=your_32_byte_hex_key_here

# Current key version (for key rotation support)
# Format: friendly-name-YYYY-MM-DD
# Change this when rotating keys (old key must still be available for decryption)
ENCRYPTION_KEY_ID=default-2024-01

# Enable encryption for new records (set to true after migration)
# When true, new Lead/ClienteGlobal/ContactoProspecto records automatically encrypt PII
ENCRYPTION_ENABLE_NEW_RECORDS=false

# Log encryption operations for audit trail
ENCRYPTION_AUDIT_LOG=true

# Encryption algorithm (do not change)
ENCRYPTION_ALGORITHM=aes-256-gcm
