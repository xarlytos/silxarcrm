# ============================================================================
# TLS/HTTPS Hardening Configuration
# ============================================================================
# Copy this file to .env and update values for your environment
# For production deployment with TLS 1.3, Nginx, and certificate pinning

# ============================================================================
# Server Configuration
# ============================================================================

# Set to true when deployed behind Nginx with TLS 1.3
TLS_ENABLED=true

# Application environment
NODE_ENV=production

# Server port (typically 5000, behind Nginx proxy)
PORT=5000

# Internal API URL (used by workers, webhooks)
API_URL=https://api.ervok.com

# Frontend URLs (comma-separated)
FRONTEND_URL=https://app.ervok.com,https://crmpropio.vercel.app

# ============================================================================
# Rate Limiting Configuration
# ============================================================================

# Redis for distributed rate limiting (optional, uses memory if not set)
# Memory-based rate limiting is fine for single-instance deployments
# For multi-instance: use Redis
REDIS_URL=redis://localhost:6379

# Alternative: Upstash Redis (serverless)
# UPSTASH_REDIS_REST_URL=https://us1-green-flamingo-....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# ============================================================================
# Security & Authentication
# ============================================================================

# JWT Secret for token signing (generate: openssl rand -base64 32)
# ⚠️ CRITICAL: Use strong random value, not this example
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Expiration times
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================================
# Database
# ============================================================================

DATABASE_URL=postgresql://user:password@localhost:5432/crm_maestro_db

# ============================================================================
# TLS Certificate Configuration
# ============================================================================

# Certificate paths (when deployed on server)
# For Let's Encrypt:
TLS_CERT_PATH=/etc/letsencrypt/live/api.ervok.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/api.ervok.com/privkey.pem
TLS_CHAIN_PATH=/etc/letsencrypt/live/api.ervok.com/chain.pem

# Certificate pinning configuration
# For production, update with actual certificate fingerprints
TLS_PINNING_ENABLED=true

# Public key pins (SPKI SHA-256) for external APIs
# Generate with: openssl s_client -connect api.elevenlabs.io:443 | \
#                openssl x509 -noout -pubkey | \
#                openssl pkey -pubin -outform DER | \
#                openssl dgst -sha256 -binary | openssl enc -base64

# ElevenLabs TTS API pins
ELEVENLABS_PIN_PRIMARY=9Z6xpKTlP4PeFnQBtKhgQ8qpH7OO9kAq5L1dF7wDhzA=
ELEVENLABS_PIN_BACKUP=abc123def456ghi789jkl012mno345pqr678stuv==

# OpenAI API pins
OPENAI_PIN_PRIMARY=rRVzL8RW8GYPuLZx1JzSB8pP/9TskJ0b7r6KuF2f8nA=
OPENAI_PIN_BACKUP=++DhSCh8qmOj4HYPa3Wq6hON+p1FbpxON3a1JXP8zQ=

# Google APIs pins
GOOGLE_PIN_PRIMARY=7L4XY+mB2U1N5vK6zQ9pR3sT8wV1aB2cD3eF4gH5iJ=
GOOGLE_PIN_BACKUP=xyz789abc123def456ghi789jkl012mno345pqr=

# ============================================================================
# External API Keys
# ============================================================================

# OpenAI (GPT models)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview

# Google APIs (Gemini, Places API)
GOOGLE_API_KEY=...
GOOGLE_PROJECT_ID=...

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=...
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io

# ============================================================================
# Firebase Configuration
# ============================================================================

FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@....iam.gserviceaccount.com
FIREBASE_SERVICE_ACCOUNT={}

# ============================================================================
# Email & Webhooks
# ============================================================================

# Resend Email Service
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# Email unsubscribe secret (change from default)
EMAIL_UNSUBSCRIBE_SECRET=your-secure-unsubscribe-secret

# ============================================================================
# Third-party Services
# ============================================================================

# Stripe (Payment processing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Printify (Print-on-Demand)
PRINTIFY_API_KEY=...
PRINTIFY_SHOP_ID=...

# Zadarma (VoIP)
ZADARMA_USER_KEY=...
ZADARMA_SECRET_KEY=...
ZADARMA_NUMBER_DID=...
ZADARMA_DEFAULT_AGENT_PHONE=...

# ============================================================================
# Logging
# ============================================================================

# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://...@sentry.io/...

# ============================================================================
# Feature Flags
# ============================================================================

# Firebase Cloud Messaging for push notifications
FCM_ENABLED=true

# AI Agent service
AI_AGENT_URL=http://localhost:8000
AI_AGENT_SECRET=your-ai-agent-secret

# ============================================================================
# Security Recommendations
# ============================================================================

# ✓ HTTPS/TLS 1.3 enforced via Nginx (see nginx.conf)
# ✓ HSTS header with 1-year max-age (configured in Nginx)
# ✓ X-Frame-Options: DENY (prevents clickjacking)
# ✓ X-Content-Type-Options: nosniff (prevents MIME-sniffing)
# ✓ Content-Security-Policy: Strict (prevents XSS/injection)
# ✓ Referrer-Policy: strict-origin-when-cross-origin
# ✓ Certificate pinning for external APIs
# ✓ Rate limiting: 100 req/min general, 10 req/15min auth
# ✓ JWT signing with strong secret
# ✓ CORS validation with whitelist
# ✓ Helmet.js for additional HTTP headers

# ============================================================================
# Production Deployment Checklist
# ============================================================================

# Before going live:
# 1. Generate strong random JWT_SECRET: openssl rand -base64 32
# 2. Set NODE_ENV=production
# 3. Configure DATABASE_URL with production database
# 4. Update FRONTEND_URL with actual domains
# 5. Obtain SSL certificate (Let's Encrypt): certbot certonly --webroot ...
# 6. Deploy Nginx config with TLS 1.3 enforcement
# 7. Generate and verify certificate pins for external APIs
# 8. Set TLS_ENABLED=true
# 9. Configure Redis for distributed rate limiting (optional)
# 10. Test: curl --tlsv1.3 https://api.domain.com/health
# 11. Run security tests (see TLS-HARDENING-IMPLEMENTATION.md)
# 12. Submit domain to HSTS preload list (https://hstspreload.org/)

# ============================================================================
# Emergency/Fallback Configuration
# ============================================================================

# If certificate renewal fails:
# - Check Let's Encrypt certbot status: sudo certbot status
# - Manual renewal: sudo certbot renew --force-renewal
# - Contact Let's Encrypt support

# If TLS enforcement causes issues:
# - Temporarily allow TLS 1.2: ssl_protocols TLSv1.3 TLSv1.2; (in nginx.conf)
# - Check client logs for TLS version used
# - Verify certificate validity: openssl x509 -in cert.pem -noout -dates

# If rate limiting is too strict:
# - Increase burst: limit_req burst=50 nodelay; (in nginx.conf)
# - Check rate limit zones: sudo nginx -T | grep limit_req_zone
# - Monitor rejection rate: grep "limiting requests" /var/log/nginx/error.log
