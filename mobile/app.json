{
  "expo": {
    "name": "CRM Maestro",
    "slug": "crm-maestro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "crm-maestro",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#faf9f7"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crmmaestro.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#faf9f7"
      },
      "package": "com.crmmaestro.app",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#078a52"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
