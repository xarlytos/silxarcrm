# ============================================================
#  Agente de Ventas por Voz — variables de entorno
#  Copia este archivo a `.env` y rellena los valores reales.
# ============================================================

# --- Gemini ---
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
# Modelo de calidad (preview, voz nativa). Default del proyecto.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Modelo de respaldo (native audio) para fallback automatico.
GEMINI_LIVE_FALLBACK_MODEL=gemini-2.5-flash-native-audio-latest
# Voz nativa de Gemini (p.ej. Puck, Charon, Kore, Fenrir, Aoede, Leda).
GEMINI_VOICE=Leda
# Idioma BCP-47. Mexico: es-US/es-MX (es-MX si esta disponible).
GEMINI_LANGUAGE=es-US
# Nivel de thinking (latencia): minimal = maxima velocidad
GEMINI_THINKING_LEVEL=minimal

# --- Gemini Chat (modo texto, para pipeline hibrido ElevenLabs) ---
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# --- Supervisor Estrategico (arquitectura jerarquica) ---
# false = conversador usa solo prompt base (default)
# true = supervisor analiza cada N turnos y emite briefing dinamico
STRATEGIST_ENABLED=false
STRATEGIST_MODEL=gemini-1.5-pro-latest
STRATEGIST_TURN_INTERVAL=5

# --- Gestor de Memoria ---
MEMORY_MAX_TURNS=15
MEMORY_SUMMARY_THRESHOLD=10

# --- ElevenLabs (pipeline hibrido: STT + TTS) ---
# Dejar API key vacia para usar Gemini Live nativo.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
# Voice ID de ElevenLabs. Buscar en https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# Formatos: "ulaw_8000" (directo a Twilio, sin conversion), "pcm_16000", "pcm_24000"
ELEVENLABS_TTS_FORMAT=ulaw_8000
# ElevenLabs latency optimization:
# 0 = minima latencia (calidad ligeramente reducida)
# 1 = balance optimo (recomendado para produccion con Flash v2.5)
# 2-3 = mas calidad
# 4 = maxima calidad, maxima latencia (NO usar en produccion)
ELEVENLABS_LATENCY_OPT=0
# Idioma STT: es, es-MX, etc.
ELEVENLABS_STT_LANGUAGE=es
# Sample rate STT: 16000 (recomendado) o 8000
ELEVENLABS_STT_SAMPLE_RATE=16000

# --- Pipeline selector ---
# "gemini" = Gemini Live nativo (STT+LLM+TTS todo en uno)
# "elevenlabs" = Hibrido (ElevenLabs STT+TTS + Gemini Chat LLM)
VOICE_PIPELINE=elevenlabs

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu_auth_token
# Numero comprado en Twilio (formato E.164), idealmente MX +52...
TWILIO_FROM_NUMBER=+521XXXXXXXXXX
# Numero al que se transfieren los hot-leads / peticiones de humano.
HUMAN_TRANSFER_NUMBER=+521XXXXXXXXXX

# --- Twilio Mexico (numeros locales para mejor answer rate) ---
# Mapping JSON de LADA -> numero E.164. Ejemplo:
# TWILIO_MX_NUMBERS={"55":"+5255XXXXXXXX","33":"+5233XXXXXXXX","81":"+5281XXXXXXXX"}
TWILIO_MX_NUMBERS=
# Estrategia de caller ID: "static" (siempre TWILIO_FROM_NUMBER) o "dynamic" (por LADA)
CALLER_ID_STRATEGY=static
# Nombre para CNAM/Branding del numero (max 15 chars)
TWILIO_CNAM_NAME=GestPro

# --- Servidor ---
# Host publico (sin esquema) por el que Twilio alcanza este servidor.
# En dev: el dominio de ngrok, p.ej. abcd-1-2-3-4.ngrok-free.app
PUBLIC_HOST=localhost:8000
PORT=8000
LOG_LEVEL=INFO

# --- Estado (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Base de datos PostgreSQL (compartida con CRM Maestro) ---
# Si se configura, el agente lee leads/spechs y escribe logs en la misma BD.
# Formato: postgresql://usuario:pass@host:puerto/bd
DATABASE_URL=

# --- CRM / RAG (Supabase) [legacy, fallback si DATABASE_URL no esta] ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key

# --- Agendado (Cal.com) ---
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# --- Alertas ---
SLACK_WEBHOOK_URL=

# --- Webhook hacia backend Express (CRM Maestro) ---
# URL base del backend para notificar estado de llamadas en tiempo real.
BACKEND_WEBHOOK_URL=http://localhost:5000
# Secreto compartido para validar webhooks (debe coincidir con AI_AGENT_SECRET del backend).
BACKEND_WEBHOOK_SECRET=supersecreto

# --- Compliance ---
# Activa el aviso de IA al inicio de la llamada (recomendado/etico).
DISCLOSE_AI=true
# Horario legal de llamadas (hora local MX, formato 24h).
CALL_HOUR_START=9
CALL_HOUR_END=20

# --- VAD / Latencia ---
# Silencio (ms) antes de que Gemini considere turno terminado.
# 200ms = estandar B2B rapido. 500ms = demasiado conservador.
VAD_SILENCE_MS=200
# Padding antes del inicio de habla (protege primeras palabras).
VAD_PREFIX_PADDING_MS=200
# Sensibilidad VAD: HIGH o LOW
VAD_START_SENSITIVITY=HIGH
VAD_END_SENSITIVITY=HIGH

# --- DSP (Digital Signal Processing) ---
# Activar noise gate + AGC para mejorar calidad de audio entrante.
# Mejora MOS +0.3-0.5 y reduce errores STT 30-50%.
ENABLE_INPUT_DSP=true

# --- Circuit Breaker por latencia ---
# Si la latencia de un componente excede el umbral, activa fallback.
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_GEMINI_STT_MS=500
CIRCUIT_BREAKER_GEMINI_LLM_MS=800
CIRCUIT_BREAKER_ELEVENLABS_TTS_MS=300
