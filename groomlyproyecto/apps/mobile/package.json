{
  "name": "@groomly/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@groomly/shared": "file:../../packages/shared",
    "@react-native-picker/picker": "^2.11.4",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.17.0",
    "expo": "~56.0.8",
    "expo-device": "^56.0.4",
    "expo-image-picker": "^56.0.15",
    "expo-linear-gradient": "~56.0.4",
    "expo-local-authentication": "^56.0.4",
    "expo-notifications": "^56.0.15",
    "expo-print": "^56.0.3",
    "expo-router": "^56.2.8",
    "expo-secure-store": "^56.0.4",
    "expo-sharing": "^56.0.15",
    "expo-status-bar": "~56.0.4",
    "lucide-react-native": "^1.17.0",
    "nativewind": "^4.2.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-native": "0.85.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-chart-kit": "^6.12.3",
    "react-native-gesture-handler": "^3.0.0",
    "react-native-reanimated": "^4.4.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-web": "^0.21.2",
    "tailwindcss": "^3.4.19",
    "victory-native": "^41.24.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@groomly/.*)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  },
  "private": true
}
