{
  "name": "groomly-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo Groomly - ERP para peluquerías caninas (Web + Mobile)",
  "scripts": {
    "web:dev": "cd apps/web && npm run dev",
    "web:build": "cd apps/web && npm run build",
    "mobile:start": "cd apps/mobile && npx expo start",
    "mobile:android": "cd apps/mobile && npx expo start --android",
    "mobile:ios": "cd apps/mobile && npx expo start --ios",
    "shared:build": "cd packages/shared && npm run build",
    "lint": "cd apps/web && npm run lint"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
